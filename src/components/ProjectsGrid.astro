---
import { projects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';
---

<section class="projects" id="projects" aria-label="Featured projects">
  <div class="projects__header">
    <p class="projects__eyebrow">Recent work</p>
    <h2 class="projects__heading">Six jobs, six neighborhoods, one standard.</h2>
    <p class="projects__sub">
      A sample of finished kitchens across Philadelphia.
      <!-- TODO: confirm with client --> Exact addresses available on request.
    </p>
  </div>

  <div class="projects__grid">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</section>

<style>
  .projects {
    padding-block: clamp(4rem, 10vw, 8rem);
    background: var(--color-paper-50);
  }

  .projects__header {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .projects__eyebrow {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy-600);
    margin-bottom: 1rem;
  }
  .projects__heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    line-height: var(--text-h2--line-height);
    max-width: 22ch;
    color: var(--color-ink-900);
    margin-bottom: 1rem;
  }
  .projects__sub {
    max-width: 55ch;
    color: var(--color-ink-600);
  }

  .projects__grid {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
  }
</style>

<script>
  import { gsap, ScrollTrigger, initGsap, prefersReducedMotion } from '../lib/motion';

  const cards = document.querySelectorAll<HTMLElement>('#projects [data-reveal]');
  if (cards.length) {
    if (prefersReducedMotion()) {
      gsap.set(cards, { clearProps: 'all' });
    } else {
      initGsap();
      gsap.set(cards, { autoAlpha: 0, y: 32 });
      ScrollTrigger.batch(cards, {
        start: 'top 88%',
        onEnter: (batch) =>
          gsap.to(batch, {
            autoAlpha: 1,
            y: 0,
            duration: 0.8,
            ease: 'expo.out',
            stagger: 0.12,
          }),
        once: true,
      });
    }
  }
</script>
