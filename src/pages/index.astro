---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageLoader from '../components/PageLoader.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import IntroStatement from '../components/IntroStatement.astro';
import Services from '../components/Services.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
import Process from '../components/Process.astro';
import StatsSection from '../components/StatsSection.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceArea from '../components/ServiceArea.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Markins Development Group | Philadelphia Kitchen, Bath & Renovation Contractor"
  description="Philadelphia design-build contractor for kitchen & bath, whole-home renovation, and new construction. Licensed, insured, and based in Port Richmond."
>
  <PageLoader />
  <Nav />
  <main id="main">
    <Hero />
    <IntroStatement />
    <Services />
    <ProjectsGrid />
    <Process />
    <StatsSection />
    <Testimonials />
    <ServiceArea />
    <FAQAccordion />
    <QuoteForm />
  </main>
  <Footer />
</BaseLayout>
