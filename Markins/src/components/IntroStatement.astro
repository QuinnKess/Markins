---
const sentences = [
  'Markins Development Group is a design-build contractor based in Port Richmond, built around one idea:',
  'run the job the way a homeowner would run it themselves, if they had the crew and the trade relationships to do it.',
  'We plan before we swing a hammer, we show up when we say we will, and we build kitchens, bathrooms, and homes that hold up under daily life — not just in photos.',
];
---

<section class="intro" id="intro-statement" aria-label="About Markins Development Group">
  <div class="intro__inner">
    <p class="intro__eyebrow">Who we are</p>
    <p class="intro__statement" data-intro-lines>
      {
        sentences.map((sentence) => (
          <span class="intro__line-wrap">
            <span class="intro__line">{sentence} </span>
          </span>
        ))
      }
    </p>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(5rem, 12vw, 9rem);
    background: var(--color-paper-50);
  }
  .intro__inner {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
  }
  .intro__eyebrow {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy-600);
    margin-bottom: 1.5rem;
  }
  .intro__statement {
    font-family: var(--font-display);
    font-weight: 420;
    font-size: var(--text-display);
    line-height: var(--text-display--line-height);
    color: var(--color-ink-900);
  }
  .intro__line-wrap {
    display: inline;
    overflow: hidden;
  }
  .intro__line {
    display: inline;
    opacity: 0;
    transition: opacity 0.6s var(--ease-hinge);
  }
  .intro__line.is-visible {
    opacity: 1;
  }
</style>

<script>
  import { gsap, ScrollTrigger, initGsap, prefersReducedMotion } from '../lib/motion';

  const section = document.getElementById('intro-statement');
  const lines = section?.querySelectorAll<HTMLElement>('.intro__line');

  if (section && lines?.length) {
    if (prefersReducedMotion()) {
      lines.forEach((el) => el.classList.add('is-visible'));
    } else {
      initGsap();
      ScrollTrigger.create({
        trigger: section,
        start: 'top 75%',
        end: 'bottom 60%',
        onEnter: () => {
          gsap.to(lines, {
            opacity: 1,
            stagger: 0.25,
            duration: 0.6,
            ease: 'power2.out',
            onStart: () => lines.forEach((el) => el.classList.add('is-visible')),
          });
        },
        once: true,
      });
    }
  }
</script>
