---
// TODO: confirm with client — placeholder figures until real numbers are provided.
const stats = [
  { value: 8, suffix: '+', label: 'Years in business' },
  { value: 60, suffix: '+', label: 'Projects completed' },
  { value: 100, suffix: '%', label: 'Licensed & insured' },
  { value: 1, suffix: '-yr', label: 'Workmanship warranty' },
];
---

<section class="stats" aria-label="Markins Development Group by the numbers">
  <div class="stats__grid">
    {
      stats.map((stat) => (
        <div class="stats__item">
          <p class="stats__value">
            <span data-count-to={stat.value}>0</span>
            <span class="stats__suffix">{stat.suffix}</span>
          </p>
          <p class="stats__label">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    background: var(--color-paper-50);
    border-block: 1px solid var(--color-paper-100);
  }
  .stats__grid {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    text-align: center;
  }
  @media (min-width: 800px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stats__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    color: var(--color-navy-800);
    font-variant-numeric: tabular-nums;
  }
  .stats__suffix {
    color: var(--color-navy-600);
  }
  .stats__label {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-ink-600);
  }
</style>

<script>
  import { gsap, ScrollTrigger, initGsap, prefersReducedMotion } from '../lib/motion';

  const counters = document.querySelectorAll<HTMLElement>('[data-count-to]');
  if (counters.length) {
    if (prefersReducedMotion()) {
      counters.forEach((el) => {
        el.textContent = el.dataset.countTo || '0';
      });
    } else {
      initGsap();
      counters.forEach((el) => {
        const target = Number(el.dataset.countTo);
        const counter = { val: 0 };
        ScrollTrigger.create({
          trigger: el,
          start: 'top 90%',
          once: true,
          onEnter: () => {
            gsap.to(counter, {
              val: target,
              duration: 1.6,
              ease: 'power2.out',
              onUpdate: () => {
                el.textContent = String(Math.round(counter.val));
              },
            });
          },
        });
      });
    }
  }
</script>
